# Copy to .env and fill in. Never commit .env.

# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

# Optional overrides (defaults shown). Full list: src/llm_gateway/config.py
# METRICS_PATH=data/metrics.db
# CACHE_PATH=.cache/cache.db
# RETRY_MAX_ATTEMPTS=5
# MOCK_LATENCY_MS=200
# MOCK_LATENCY_JITTER_MS=50
